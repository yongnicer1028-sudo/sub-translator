<?xml version="1.0" encoding="utf-8"?>
<!--
    자막창 레이아웃.
    - controlBar: 평소엔 숨겨져 있다가(gone), captionBox를 더블탭하면 나타나는 작은 버튼 2개짜리
      줄이에요. btnToggleActive(활성/비활성 전환) / btnClose(닫기=번역 중지).
    - captionBox: 실제로 번역 글자가 보이는 검은 박스 (더블탭=위 controlBar 보이기/숨기기,
      드래그=이동)
    - captionScroll: captionBox 안에서 실제로 글자가 올라가는 스크롤 영역이에요. 자막이
      쌓여서 captionScroll의 높이(세로 크기)보다 길어지면, 넘치는 부분은 화면을 끝없이
      키우는 대신 손가락으로 위/아래 스크롤해서 볼 수 있어요.
    - resizeHandleLeft / resizeHandleRight: 박스 양쪽 가장자리의 좁은 영역. 여기를 좌우로
      끌면 자막창 너비가 늘었다 줄었다 해요.
    - resizeHandleBottom: 박스 아래쪽 가장자리. 여기를 위아래로 끌면 captionScroll의
      높이(한 번에 보이는 자막 양)가 늘었다 줄었다 해요.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/controlBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/btnToggleActive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/overlay_bubble_bg"
            android:clickable="true"
            android:focusable="true"
            android:text="활성"
            android:textColor="@color/overlay_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <View
            android:layout_width="8dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/btnClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/overlay_bubble_bg"
            android:clickable="true"
            android:focusable="true"
            android:text="닫기"
            android:textColor="@color/overlay_text"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/captionBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/overlay_bubble_bg">

            <ScrollView
                android:id="@+id/captionScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="vertical">

                <TextView
                    android:id="@+id/textCaption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="start"
                    android:lineSpacingExtra="3dp"
                    android:text="번역 대기 중…"
                    android:textColor="@color/overlay_text"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </ScrollView>

        </LinearLayout>

        <View
            android:id="@+id/resizeHandleLeft"
            android:layout_width="16dp"
            android:layout_height="match_parent"
            android:layout_gravity="start" />

        <View
            android:id="@+id/resizeHandleRight"
            android:layout_width="16dp"
            android:layout_height="match_parent"
            android:layout_gravity="end" />

        <View
            android:id="@+id/resizeHandleBottom"
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:layout_gravity="bottom" />

    </FrameLayout>

</LinearLayout>
