<?xml version="1.0" encoding="utf-8"?>
<!--
    자막창 레이아웃.
    - controlBar: 평소엔 숨겨져 있다가(gone), dragHandle을 더블탭하면 나타나는 작은 버튼
      2개짜리 줄이에요. btnToggleActive(활성/비활성 전환) / btnClose(닫기=번역 중지).
    - captionBox: 실제로 번역 글자가 보이는 검은 박스.
    - dragHandle: captionBox 맨 위의 작은 손잡이 줄(가운데 흰 막대 표시). 더블탭=위
      controlBar 보이기/숨기기, 드래그=창 이동을 여기서 담당해요.
      ⚠ v11: 원래는 captionBox 전체(글자 포함)를 눌러서 드래그/더블탭했는데, 자막을
      스크롤하려고 captionScroll(스크롤 영역)을 추가한 뒤로는 그 영역을 만지면
      스크롤이 그 터치를 먼저 가로채서 더블탭도, 드래그도 잘 안 먹는 문제가 있었어요.
      그래서 드래그/더블탭 전용 손잡이를 스크롤 영역과 분리된 별도 줄로 뺐어요.
    - captionScroll: captionBox 안에서 실제로 글자가 올라가는 스크롤 영역이에요. 자막이
      쌓여서 captionScroll의 높이(세로 크기)보다 길어지면, 넘치는 부분은 화면을 끝없이
      키우는 대신 손가락으로 위/아래 스크롤해서 볼 수 있어요.
    - resizeHandleLeft / resizeHandleRight: 박스 양쪽 가장자리의 영역. 여기를 좌우로
      끌면 자막창 너비가 늘었다 줄었다 해요. v11에서 더 넓고(24dp) 눈에 보이게(옅은
      흰색 띠) 바꿔서 손가락으로 잡기 편하게 했어요.
    - resizeHandleBottom: 박스 아래쪽 가장자리. 여기를 위아래로 끌면 captionScroll의
      높이(한 번에 보이는 자막 양)가 늘었다 줄었다 해요. 마찬가지로 24dp로 넓히고
      보이게 바꿨어요.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/controlBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/btnToggleActive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/overlay_bubble_bg"
            android:clickable="true"
            android:focusable="true"
            android:text="활성"
            android:textColor="@color/overlay_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <View
            android:layout_width="8dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/btnClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/overlay_bubble_bg"
            android:clickable="true"
            android:focusable="true"
            android:text="닫기"
            android:textColor="@color/overlay_text"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/captionBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/overlay_bubble_bg">

            <FrameLayout
                android:id="@+id/dragHandle"
                android:layout_width="match_parent"
                android:layout_height="26dp"
                android:clickable="true"
                android:focusable="true">

                <View
                    android:layout_width="36dp"
                    android:layout_height="4dp"
                    android:layout_gravity="center"
                    android:background="#66FFFFFF" />

            </FrameLayout>

            <ScrollView
                android:id="@+id/captionScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="vertical">

                <TextView
                    android:id="@+id/textCaption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="start"
                    android:lineSpacingExtra="3dp"
                    android:text="번역 대기 중…"
                    android:textColor="@color/overlay_text"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </ScrollView>

        </LinearLayout>

        <View
            android:id="@+id/resizeHandleLeft"
            android:layout_width="24dp"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:background="#22FFFFFF" />

        <View
            android:id="@+id/resizeHandleRight"
            android:layout_width="24dp"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:background="#22FFFFFF" />

        <View
            android:id="@+id/resizeHandleBottom"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:layout_gravity="bottom"
            android:background="#22FFFFFF" />

    </FrameLayout>

</LinearLayout>
